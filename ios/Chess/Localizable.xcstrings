    "Nothing attacks it, and it's guarded by %lld of your pieces.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada la ataca y la defienden %lld de tus piezas."
          }
        },
        "hi": {
          "stringUnit": {
