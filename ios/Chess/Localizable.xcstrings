        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे बढ़ता है, पहली चाल में दो खाने। यह तिरछा मारता है।"
          }
        }
      }
    },
    "Steps one square in any direction. Keep him safe: that's the whole game.": {
      "localizations": {
