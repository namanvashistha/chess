          "stringUnit": {
            "state": "translated",
            "value": "चलो शतरंज का एक शांत खेल खेलें।"
          }
        }
      }
    },
    "Light and dark follow your iPhone's appearance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modos claro y oscuro siguen la apariencia de tu iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइट और डार्क मोड आपके iPhone की सेटिंग के अनुसार चलते हैं।"
          }
        }
      }
    },
    "Locked. Beat the %@ %lld times to open it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Locked. Beat the %1$@ %2$lld times to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Gana al %1$@ %2$lld veces para desbloquearlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद है। इसे खोलने के लिए %1$@ को %2$lld बार हराएँ।"
          }
        }
      }
    },
    "Look at your %@": {
      "localizations": {
