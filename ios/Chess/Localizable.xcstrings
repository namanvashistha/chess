    "Move it, block the line, or take the checking piece.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévelo, bloquea la línea o captura la pieza que da jaque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राजा को हटाएँ, रास्ता रोकें, या शह देने वाले मोहरे को मारें।"
          }
        }
      }
    },
    "Moves in straight lines, up, down or across, as far as it likes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueve en línea recta, arriba, abajo o de lado, tan lejos como quiera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधी रेखा में चलता है, ऊपर, नीचे या आड़ा, जितनी दूर चाहे।"
          }
        }
      }
    },
    "Neither side has enough left to mate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A ningún bando le queda material para dar mate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी के पास मात देने लायक मोहरे नहीं बचे।"
          }
        }
      }
    },
